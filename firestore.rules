/**
 * @fileoverview Firestore Security Rules for the e-commerce application.
 *
 * Core Philosophy:
 * This ruleset enforces a strict admin-only access model for managing core application data. Public read access is granted where necessary for the user-facing storefront.
 *
 * Data Structure:
 * - /products/{productId}: Stores product information. Publicly readable.
 * - /categories/{categoryId}: Stores category information. Publicly readable.
 * - /banners/{bannerId}: Stores promotional banner information. Publicly readable.
 * - /roles_admin/{uid}: Indicates admin privileges; presence of a document for a user grants admin rights.
 * - /settings/enquiry: Stores WhatsApp enquiry settings. Publicly readable, admin writable.
 *
 * Key Security Decisions:
 * - Public read access: All users (authenticated or not) can read products, categories, banners, and enquiry settings.
 * - Admin-only write access: All write operations on core data collections are restricted to admin users.
 * - Authorization Independence: Admin status is determined solely by the existence of a document in /roles_admin/{uid}, avoiding costly `get()` calls.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Checks if the current user is signed in.
     * @path N/A
     * @allow N/A
     * @deny N/A
     * @principle Verified Identity: Ensures that all authorization decisions are based on a verified user identity.
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * @description Checks if the current user is an admin by verifying the existence of their UID in the roles_admin collection.
     * @path N/A
     * @allow N/A
     * @deny N/A
     * @principle Role-Based Access Control: Only users with an admin role can access certain resources.
     */
    function isAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid));
    }

    /**
     * @description Rules for the /products collection.
     * @path /products/{productId}
     * @allow (read) Anyone can view products.
     * @allow (write) An admin can manage products.
     * @deny (write) A non-admin attempts to manage a product.
     * @principle Public Read, Admin Write: Allows public visibility of products while securing management.
     */
    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    /**
     * @description Rules for the /categories collection.
     * @path /categories/{categoryId}
     * @allow (read) Anyone can view categories.
     * @allow (write) An admin can manage categories.
     * @deny (write) A non-admin attempts to manage a category.
     * @principle Public Read, Admin Write: Allows public visibility of categories while securing management.
     */
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    /**
     * @description Rules for the /banners collection.
     * @path /banners/{bannerId}
     * @allow (read) Anyone can view banners.
     * @allow (write) An admin can manage banners.
     * @deny (write) A non-admin attempts to manage a banner.
     * @principle Public Read, Admin Write: Allows public visibility of banners while securing management.
     */
    match /banners/{bannerId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    /**
     * @description Rules for the /roles_admin collection.
     * @path /roles_admin/{uid}
     * @allow (get) Any signed-in user's token can be used by server-side rules (like Storage rules) to check for a document's existence. This rule does NOT allow client-side reads.
     * @allow (list, write) Only admins can manage other admin roles.
     * @deny (write) A non-admin attempts to create an admin role.
     */
    match /roles_admin/{uid} {
        allow get: if isSignedIn() && (request.auth.uid == uid || isAdmin());
        allow list, create, update, delete: if isAdmin();
    }

    /**
     * @description Rules for the /settings document. This allows storing various app settings.
     * @path /settings/{settingId}
     * @allow (read) Anyone can read settings.
     * @allow (write) Only admins can change settings.
     * @deny (write) A non-admin attempts to change a setting.
     */
    match /settings/{settingId} {
        allow read: if settingId == 'enquiry' || isAdmin();
        allow write: if isAdmin();
    }

    // New multi-vendor collections are restricted until the corresponding
    // validated server workflows and emulator tests are ready.
    match /seller_applications/{applicationId} {
      allow create: if request.auth != null &&
        applicationId == request.auth.uid &&
        request.resource.data.keys().hasOnly([
          'ownerUid', 'businessName', 'businessCategory',
          'contactEmail', 'contactPhone', 'description',
          'status', 'submittedAt'
        ]) &&
        request.resource.data.ownerUid == request.auth.uid &&
        request.resource.data.status == 'pending' &&
        request.resource.data.businessName is string &&
        request.resource.data.businessName.size() >= 2 &&
        request.resource.data.businessName.size() <= 120 &&
        request.resource.data.businessCategory in ['home-bakery', 'art', 'handmade', 'other'] &&
        request.resource.data.contactEmail is string &&
        request.resource.data.contactEmail.size() <= 254 &&
        request.resource.data.contactPhone is string &&
        request.resource.data.contactPhone.size() <= 40 &&
        request.resource.data.description is string &&
        request.resource.data.description.size() <= 2000 &&
        request.resource.data.submittedAt == request.time;
      allow get: if isAdmin() || (request.auth != null && applicationId == request.auth.uid);
      allow list, update, delete: if isAdmin();
    }
    match /sellers/{sellerId} {
      allow get: if isAdmin() || (request.auth != null &&
        resource.data.ownerUid == request.auth.uid) || resource.data.status == 'active';
      allow list: if isAdmin() || resource.data.status == 'active';
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (
        isSignedIn() &&
        sellerId == request.auth.uid &&
        resource.data.ownerUid == request.auth.uid &&
        resource.data.status == 'active' &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'description', 'contactPhone', 'isOpen', 'updatedAt'
        ]) &&
        request.resource.data.description is string &&
        request.resource.data.description.size() <= 2000 &&
        request.resource.data.contactPhone is string &&
        request.resource.data.contactPhone.size() <= 40 &&
        request.resource.data.isOpen is bool &&
        request.resource.data.updatedAt == request.time
      );
    }

    function sellerActive(sellerId) {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/sellers/$(sellerId)) &&
        get(/databases/$(database)/documents/sellers/$(sellerId)).data.ownerUid == request.auth.uid &&
        get(/databases/$(database)/documents/sellers/$(sellerId)).data.status == 'active' &&
        get(/databases/$(database)/documents/sellers/$(sellerId)).data.accessEndsAt > request.time;
    }

    function validMarketplaceProduct(p) {
      return p.keys().hasOnly([
        'sellerId', 'name', 'description', 'price', 'category', 'imageUrls',
        'showPrice', 'availability', 'stockQuantity', 'preparationDays',
        'status', 'createdAt', 'updatedAt'
      ]) &&
      p.sellerId is string &&
      p.name is string && p.name.size() >= 2 && p.name.size() <= 120 &&
      p.description is string && p.description.size() <= 2000 &&
      p.category is string && p.category.size() > 0 && p.category.size() <= 80 &&
      p.price is number && p.price >= 0 && p.price <= 10000000 &&
      p.imageUrls is list && p.imageUrls.size() <= 10 &&
      p.showPrice is bool &&
      p.availability in ['available', 'unavailable', 'made-to-order'] &&
      p.stockQuantity is int && p.stockQuantity >= 0 &&
      p.preparationDays is int && p.preparationDays >= 0 &&
      p.status in ['draft', 'published'] &&
      p.createdAt is timestamp && p.updatedAt is timestamp;
    }

    match /marketplace_products/{productId} {
      // Public queries must include where('status', '==', 'published').
      // Seller dashboard queries must include where('sellerId', '==', auth.uid).
      allow get, list: if isAdmin() ||
        (isSignedIn() && resource.data.sellerId == request.auth.uid) ||
        resource.data.status == 'published';
      allow create: if sellerActive(request.resource.data.sellerId) &&
        request.resource.data.sellerId == request.auth.uid &&
        validMarketplaceProduct(request.resource.data) &&
        request.resource.data.createdAt == request.time &&
        request.resource.data.updatedAt == request.time;
      allow update: if sellerActive(resource.data.sellerId) &&
        resource.data.sellerId == request.auth.uid &&
        request.resource.data.sellerId == resource.data.sellerId &&
        request.resource.data.createdAt == resource.data.createdAt &&
        validMarketplaceProduct(request.resource.data) &&
        request.resource.data.updatedAt == request.time;
      allow delete: if sellerActive(resource.data.sellerId) &&
        resource.data.sellerId == request.auth.uid;
      allow create, update, delete: if isAdmin();
    }
    // Each order is one verified seller listing. Client-provided prices
    // and seller identities must match the current Firestore product.
    function orderProduct(productId) {
      return get(/databases/$(database)/documents/marketplace_products/$(productId)).data;
    }

    function validNewOrder(d) {
      return isSignedIn() &&
        d.keys().hasOnly([
          'buyerUid', 'sellerId', 'productId', 'productName', 'quantity',
          'unitPrice', 'subtotal', 'status', 'customerName', 'customerPhone',
          'deliveryAddress', 'customerNote', 'paymentMethod', 'createdAt', 'updatedAt'
        ]) &&
        d.keys().hasAll([
          'buyerUid', 'sellerId', 'productId', 'productName', 'quantity',
          'unitPrice', 'subtotal', 'status', 'customerName', 'customerPhone',
          'deliveryAddress', 'customerNote', 'paymentMethod', 'createdAt', 'updatedAt'
        ]) &&
        d.buyerUid == request.auth.uid &&
        d.productId is string &&
        d.quantity is int && d.quantity >= 1 && d.quantity <= 99 &&
        d.customerName is string && d.customerName.size() >= 2 && d.customerName.size() <= 120 &&
        d.customerPhone is string && d.customerPhone.size() >= 5 && d.customerPhone.size() <= 40 &&
        d.deliveryAddress is string && d.deliveryAddress.size() >= 10 && d.deliveryAddress.size() <= 1000 &&
        d.customerNote is string && d.customerNote.size() <= 1000 &&
        d.paymentMethod == 'cod' &&
        d.status == 'pending' &&
        d.createdAt == request.time && d.updatedAt == request.time &&
        exists(/databases/$(database)/documents/marketplace_products/$(d.productId)) &&
        orderProduct(d.productId).status == 'published' &&
        orderProduct(d.productId).availability != 'unavailable' &&
        orderProduct(d.productId).showPrice == true &&
        d.sellerId == orderProduct(d.productId).sellerId &&
        d.productName == orderProduct(d.productId).name &&
        d.unitPrice == orderProduct(d.productId).price &&
        d.subtotal == d.quantity * d.unitPrice &&
        exists(/databases/$(database)/documents/sellers/$(d.sellerId)) &&
        get(/databases/$(database)/documents/sellers/$(d.sellerId)).data.status == 'active' &&
        get(/databases/$(database)/documents/sellers/$(d.sellerId)).data.isOpen == true &&
        get(/databases/$(database)/documents/sellers/$(d.sellerId)).data.accessEndsAt > request.time;
    }

    match /checkout_orders/{checkoutId} {
      allow read, write: if false;
    }

    match /seller_orders/{orderId} {
      allow create: if validNewOrder(request.resource.data);
      allow get, list: if isAdmin() ||
        (isSignedIn() && resource.data.buyerUid == request.auth.uid) ||
        (isSignedIn() && resource.data.sellerId == request.auth.uid);
      allow update: if isAdmin() || (
        isSignedIn() &&
        resource.data.sellerId == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt']) &&
        request.resource.data.updatedAt == request.time &&
        (
          (resource.data.status == 'pending' && request.resource.data.status in ['accepted', 'rejected']) ||
          (resource.data.status == 'accepted' && request.resource.data.status in ['preparing', 'cancelled']) ||
          (resource.data.status == 'preparing' && request.resource.data.status in ['ready', 'cancelled']) ||
          (resource.data.status == 'ready' && request.resource.data.status == 'completed')
        )
      );
      allow delete: if false;
    }
    match /conversations/{conversationId}/{nested=**} {
      allow read, write: if false;
    }
    match /audit_logs/{logId} {
      allow read, write: if false;
    }

  }
}
