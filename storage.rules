rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Keep all image uploads restricted to the same roles_admin/{uid}
    // documents used by the Firestore rules and the admin dashboard.
    function isAdmin() {
      return request.auth != null &&
        firestore.exists(/databases/(default)/documents/roles_admin/$(request.auth.uid));
    }

    // Legacy product images. A user must be the named admin uploader.
    match /products/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId && isAdmin();
    }

    // Homepage banners: public images, admin-only upload and deletion.
    // Each upload gets a unique filename, preventing accidental overwrites.
    match /banners/{userId}/{fileName} {
      allow get: if true;
      allow list: if false;
      allow create: if isAdmin() &&
        request.auth.uid == userId &&
        request.resource.size <= 1000000 &&
        request.resource.contentType in ['image/jpeg', 'image/png'];
      allow update: if false;
      allow delete: if isAdmin() && request.auth.uid == userId;
    }
  }
}
